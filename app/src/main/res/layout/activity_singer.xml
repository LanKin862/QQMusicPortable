<?xml version="1.0" encoding="utf-8"?>
<!--
  歌手详情页。

  结构: 上半屏是可折叠的歌手封面, 折叠完只剩一条工具栏, 分页栏正好贴上去。
  配色不在这里写死 —— 根布局背景、工具栏背景、封面底部的渐变遮罩都由
  SingerActivity 按封面主色实时刷, 所以这里只给初值。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/singer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@android:color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <ImageView
                android:id="@+id/singer_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/singer_cover_desc"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.5" />

            <!--
              封面顶部同样来一道渐变: 状态栏吃的是主题色 (压自封面底部), 如果封面顶边偏浅,
              状态栏和封面之间就会有一条硬接缝 —— 播放页没这个问题, 因为那一屏顶部是纯色背景。
              加上这一层之后, 主题色顺着状态栏「化」进封面里。
            -->
            <View
                android:id="@+id/cover_top_fade"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="top" />

            <!--
              封面底部的渐变遮罩: 从透明过渡到信息流背景色。
              没有它的话, 封面底边是一条硬直线, 跟下面的列表像两张图拼起来的。
            -->
            <View
                android:id="@+id/cover_fade"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_gravity="bottom" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/singer_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 分页栏: 封面收起后它就贴在工具栏下沿 -->
        <LinearLayout
            android:id="@+id/singer_tabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_songs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/singer_tab_songs"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_albums"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/singer_tab_albums"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 单曲数量 + 右侧多选入口 (只有单曲页显示) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/singer_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_multi"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_multi_select"
                android:scaleType="centerInside"
                android:src="@drawable/ic_multi" />
        </LinearLayout>

        <!-- 批量操作栏: 进入多选后出现在数量行下方 -->
        <LinearLayout
            android:id="@+id/batch_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/batch_play"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:gravity="center"
                android:text="@string/action_play_selected"
                android:textColor="@color/brand"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/batch_add_playlist"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:gravity="center"
                android:text="@string/action_add_to_playlist"
                android:textColor="@color/brand"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/batch_download"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:gravity="center"
                android:text="@string/action_download"
                android:textColor="@color/brand"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/batch_select_all"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/action_select_all"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/song_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="84dp"
                android:scrollbars="none" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/album_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="84dp"
                android:scrollbars="none"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/brand"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 高度必须写死 60dp: include 的 layout_height 会覆盖被包含布局根节点的同名属性,
         写 wrap_content 就变成「内容高度」(44dp), 比别的页面矮一截 -->
    <include
        layout="@layout/view_mini_player"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
