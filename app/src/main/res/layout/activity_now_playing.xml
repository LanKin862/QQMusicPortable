<?xml version="1.0" encoding="utf-8"?>
<!-- 播放详情页
     顶部栏: 左上角收纳(收起)图标
     中部  : ViewPager2 —— 左页=封面+歌名+歌手, 右页=歌词详情
     底部  : 进度条 + 功能按键 (循环方式 / 上一首 / 播放暂停 / 下一首 / 播放列表) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/player_root"
    android:background="@color/bg_player"
    android:orientation="vertical">

    <!-- ============ 顶部栏 ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <ImageButton
            android:id="@+id/btn_collapse"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_on_player" />

        <!-- 右上角「加入歌单」: 与左上角收起图标同尺寸、同边距, 左右对称 -->
        <ImageButton
            android:id="@+id/btn_add_playlist"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_to_playlist_title"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add"
            android:visibility="gone"
            app:tint="@color/text_on_player" />

        <!-- 翻页指示: 两张卡片对应「封面」与「歌词」两页 -->
        <LinearLayout
            android:id="@+id/page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_cover"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_dot_active" />

            <View
                android:id="@+id/dot_lyric"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_dot_inactive" />
        </LinearLayout>
    </FrameLayout>

    <!-- ============ 内容区: 左右翻页 ============ -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ============ 进度条 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp">

        <!-- 细长一条: 高度压到 6dp, 时间文字挪到下面一行, 进度条才能铺满整幅宽度 -->
        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:background="@null"
            android:max="100"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"
            android:thumb="@null"
            android:thumbOffset="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/position"
                style="@style/Text.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:textColor="@color/text_on_player_secondary"
                tools:text="0:00" />

            <TextView
                android:id="@+id/duration"
                style="@style/Text.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/text_on_player_secondary"
                tools:text="3:45" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 功能按键 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="18dp">

        <ImageButton
            android:id="@+id/btn_mode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play_mode_list_loop"
            android:padding="11dp"
            android:src="@drawable/ic_repeat"
            app:tint="@color/text_on_player_secondary" />

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_prev"
            android:padding="11dp"
            android:src="@drawable/ic_skip_previous"
            app:tint="@color/text_on_player" />

        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_play"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play_ring"
            app:tint="@color/text_on_player" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_next"
            android:padding="11dp"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/text_on_player" />

        <ImageButton
            android:id="@+id/btn_queue"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_queue"
            android:padding="11dp"
            android:src="@drawable/ic_queue"
            app:tint="@color/text_on_player_secondary" />
    </LinearLayout>
</LinearLayout>
