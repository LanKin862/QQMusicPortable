<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础主题: 日间, 不使用 DayNight 以减少资源与夜间资源的加载开销 -->
    <style name="Theme.QQMusicPortable" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/bg_page</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <!-- 关闭系统启动预览窗口: 否则布局建立失败时会一直停在纯色窗口上 (表现为白屏),
             关掉后至少能看到主题背景色变化, 便于区分「没画出来」和「画出来是空的」 -->
        <item name="android:windowDisablePreview" tools:targetApi="m">true</item>
    </style>

    <!-- 播放页: 深色沉浸 -->
    <style name="Theme.QQMusicPortable.Player">
        <item name="android:windowBackground">@color/bg_player</item>
        <item name="android:statusBarColor">@color/bg_player</item>
        <item name="android:navigationBarColor">@color/bg_player</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_on_player</item>
    </style>

    <!-- 歌手详情: 透明状态栏, 让封面顶到屏幕最上沿 -->
    <style name="Theme.QQMusicPortable.Singer">
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/bg_player</item>
        <item name="android:navigationBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_on_player</item>
    </style>

    <!-- 二维码登录: 半透明弹窗风格 -->
    <style name="Theme.QQMusicPortable.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
    </style>

    <style name="Theme.QQMusicPortable.Settings">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <!--
          设置项字号整体小一号。
          androidx 的 preference 布局里, 标题取 ?android:textAppearanceListItem、摘要取
          ?android:textAppearanceSmall, 所以在设置页的主题里换掉这两个 textAppearance 就够了,
          不用复制一份 preference.xml (那会丢掉图标占位、分割线等细节)。
          这两个属性只在本 Activity 内生效, 不影响其它页面的列表。
        -->
        <item name="android:textAppearanceListItem">@style/Text.SettingsItem</item>
        <item name="android:textAppearanceSmall">@style/Text.SettingsSummary</item>
    </style>

    <style name="Text.SettingsItem" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.SettingsSummary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 文本 -->
    <style name="Text.Title" parent="android:Widget.TextView">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Section" parent="android:Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body" parent="android:Widget.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Secondary" parent="android:Widget.TextView">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 卡片 -->
    <style name="Card.Base" parent="CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <!-- 列表项通用点击背景 -->
    <style name="Item_Clickable">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 设置项 -->
    <style name="Setting_Item">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <!-- 稍小的顶栏标题 (默认 MaterialToolbar 是 20sp) -->
    <style name="TextAppearance.ToolbarSmall" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
